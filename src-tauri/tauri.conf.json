{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Narra",
  "version": "0.1.0",
  "identifier": "com.renz.narra",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Narra",
        "width": 1040,
        "height": 740,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
